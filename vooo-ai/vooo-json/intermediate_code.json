      "calculation": "(CODE=='3-1-20')?'CAT':(CODE=='8-5-12-12-15')?'HELLO':(CODE=='3-15-4-5')?'CODE':'WORD'",
      "explanation": "A1Z26 cipher: numbers map to letters. 3-1-20=C-A-T, 8-5-12-12-15=H-E-L-L-O",
      "options": ["CAT", "HELLO", "CODE", "WORD"]
    },
