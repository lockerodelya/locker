  "template_id": "RAT_L1_06",
  "pattern": "The ratio of two numbers is {A}:{B}. Their sum is {T}. Find the smaller number.",
  "variables": {
    "A": { "values": [2,3,4,5,6,7,8,9,10] },
    "B": { "values": [1,2,3,4,5,6,7,8,9] },
    "T": { "values": [20,30,40,50,60,70,80,90,100] }
  },
  "calculation": "(T*min(A,B))/(A+B)",
  "explanation": "Smaller number = Total × smaller ratio part / (A+B)"
}

