{
  "puzzle_type": "toddler_math",
  "display_name": "👶 Toddler Math",
  "templates": [
    {
      "template_id": "TOD_COUNT_01",
      "pattern": "🐱🐱🐱 = ?",
      "variables": {
        "EMOJI": {"values": ["🐱", "🐶", "🐰", "🐻", "🐯", "🐸", "🐙", "🦋", "🐝", "🐢"]},
        "COUNT": {"min": 1, "max": 5}
      },
      "pattern_builder": "repeat(EMOJI, COUNT) + ' = ?'",
      "calculation": "COUNT",
      "explanation": "There are [COUNT] [EMOJI]s."
    },
    {
      "template_id": "TOD_MATCH_01",
      "pattern": "Match [NUMBER] with:",
      "options_builder": "generate_options(NUMBER, EMOJI)",
      "variables": {
        "NUMBER": {"min": 1, "max": 5},
        "EMOJI": {"values": ["🍎", "🍌", "🍪", "🎈", "⭐", "❤️", "🔵", "🔺"]}
      },
      "calculation": "NUMBER",
      "answer_type": "multiple_choice_visual"
    },
    {
      "template_id": "TOD_ADD_PIC_01",
      "pattern": "[A_EMOJI] + [B_EMOJI] = ?",
      "variables": {
        "A_EMOJI": {"values": ["🍎", "🍌", "🍪"]},
        "B_EMOJI": {"values": ["🍎", "🍌", "🍪"]},
        "A_COUNT": {"min": 1, "max": 3},
        "B_COUNT": {"min": 1, "max": 3}
      },
      "pattern_builder": "repeat(A_EMOJI, A_COUNT) + ' + ' + repeat(B_EMOJI, B_COUNT) + ' = ?'",
      "calculation": "A_COUNT + B_COUNT",
      "explanation": "[A_COUNT] + [B_COUNT] = [RESULT]"
    },
    {
      "template_id": "TOD_SHAPE_01",
      "pattern": "Find the [SHAPE]:",
      "variables": {
        "SHAPE": {"values": ["circle", "square", "triangle", "star", "heart"]}
      },
      "options": ["○", "□", "△", "★", "♥", "◇", "▢", "⬡"],
      "calculation": "SHAPE",
      "answer_type": "shape_selector"
    },
    {
      "template_id": "TOD_SIZE_01",
      "pattern": "Which is bigger? [A_EMOJI] or [B_EMOJI]?",
      "variables": {
        "A_EMOJI": {"values": ["🐘", "🦒", "🐋", "🏠", "🌳"]},
        "B_EMOJI": {"values": ["🐭", "🐦", "🐜", "📦", "🌸"]}
      },
      "calculation": "A_EMOJI",
      "answer_type": "comparison"
    },
    {
      "template_id": "TOD_COLOR_01",
      "pattern": "Find the [COLOR] one:",
      "variables": {
        "COLOR": {"values": ["red", "blue", "yellow", "green"]}
      },
      "options": ["🔴", "🟡", "🔵", "🟢", "⚫", "⚪"],
      "calculation": "COLOR",
      "answer_type": "color_picker"
    },
{
  "template_id": "TOD_SEQ_01",
  "pattern": "[A], [B], ?, [D]",
  "variables": {
    "A": {"min": 1, "max": 5},
    "STEP": {"values": [1, 2]}
  },
  "pattern_builder": "A + ', ' + (A + STEP) + ', ?, ' + (A + 3*STEP)",
  "calculation": "A + (2 * STEP)",
  "explanation": "Counting by [STEP]: [A], [A+STEP], [A+2*STEP], [A+3*STEP]"
},
    {
      "template_id": "TOD_PATTERN_01",
      "pattern": "🔴🟡🔴🟡?",
      "variables": {
        "PATTERN": {"values": ["ABAB", "AABB", "ABCABC"]}
      },
      "calculation": "next_in_pattern(PATTERN)",
      "answer_type": "pattern_completion"
    }
  ],
  "responses": {
    "correct": ["Good job! 👍", "You're smart! 🧠", "Perfect! ⭐", "Wow! 🎉"],
    "incorrect": ["Try again! 💪", "Look carefully 👀", "Almost! 😊", "You can do it! 🌟"]
  }

}
