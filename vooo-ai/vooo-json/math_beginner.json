  "templates": [
    {
      "template_id": "BEG_ADD_01",
      "pattern_builder": "function(v) { return v.PERSON + ' ' + v.HAS + ' ' + v.A + ' ' + v.OBJECT_A + '. ' + v.ACTION + ' ' + v.B + ' ' + v.OBJECT_B + '. How many total ' + v.OBJECT_PLURAL + '?'; }",
      "variables": {
        "A": {"min": 1, "max": 25},
        "B": {"min": 1, "max": 25},
        "PERSON": {"values": ["Rohan", "Priya", "Amit", "Sara", "Tom", "Lucy", "Sam", "Maya", "Alex", "Emma"]},
        "HAS": {"values": ["has", "finds", "gets", "buys", "collects", "sees"]},
        "OBJECT_A": {"values": ["apple", "toy", "ball", "book", "candy", "pencil", "marble", "cookie", "sticker", "block"]},
        "ACTION": {"values": ["Then gets", "Finds", "Buys", "Receives", "Collects"]},
        "OBJECT_B": {"values": ["more", "extra", "additional", ""]},
        "OBJECT_PLURAL": {"values": ["apples", "toys", "balls", "books", "candies", "pencils", "marbles", "cookies", "stickers", "blocks"]}
      },
      "calculation": "A + B",
      "explanation": "[A] plus [B] equals [RESULT] [OBJECT_PLURAL]."
    },
    {
      "template_id": "BEG_SUB_01",
