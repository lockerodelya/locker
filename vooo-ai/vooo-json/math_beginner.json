        "GIVES": {"values": ["gives", "shares", "sells", "loses", "eats"]},
        "RECEIVER": {"values": ["friend", "sister", "brother", "classmate", "teacher"]}
      },
      "calculation": "A - B",
      "explanation": "[A] minus [B] equals [RESULT] [OBJECT_PLURAL] left."
    },
