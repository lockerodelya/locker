      "template_id": "PROP_BEG_01",
      "pattern": "If it is [CONDITION], then [RESULT]. It is [CONDITION]. What happens?",
      "variables": {
        "CONDITION": {"values": ["raining", "sunny", "cold", "hot", "windy", "snowing", "stormy", "cloudy", "foggy", "humid"]},
        "RESULT": {"values": ["I take an umbrella", "I wear sunglasses", "I wear a coat", "I drink water", "I close windows", "I wear boots", "I stay inside", "I bring jacket", "I use heater", "I turn on AC"]}
      },
      "calculation": "RESULT",
      "explanation": "If [CONDITION], then [RESULT]. Since it is [CONDITION], [RESULT] must happen"
    },
    {
