    {
      "template_id": "ADV_SIMUL_01",
      "pattern": "[A]x + [B]y = [C], [D]x + [E]y = [F]. x = ?",
      "variables": {
        "A": {"min": 1, "max": 5},
        "B": {"min": 1, "max": 5},
        "D": {"min": 6, "max": 10},
        "E": {"min": 6, "max": 10},
        "X_VAL": {"min": 1, "max": 10},
        "Y_VAL": {"min": 1, "max": 10},
        "C": {"calc": "A*X_VAL + B*Y_VAL"},
        "F": {"calc": "D*X_VAL + E*Y_VAL"}
      },
      "calculation": "X_VAL",
      "explanation": "Solving the system: x = [X_VAL], y = [Y_VAL]"
    },

