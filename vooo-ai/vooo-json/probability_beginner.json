      "template_id": "BEG_PROB_01",
      "pattern": "A [CONTAINER] has [A] [COLOR1] and [B] [COLOR2] [ITEM]. Total [ITEM] = ?",
      "variables": {
        "A": {"min": 3, "max": 15},
        "B": {"min": 3, "max": 15},
        "CONTAINER": {"values": ["bag", "box", "basket", "jar", "bowl"]},
        "COLOR1": {"values": ["red", "blue", "green", "yellow", "white", "black"]},
        "COLOR2": {"values": ["red", "blue", "green", "yellow", "white", "black"]},
        "ITEM": {"values": ["balls", "marbles", "stones", "beads", "candies"]}
      },
      "calculation": "A + B",
      "explanation": "[A] + [B] = [RESULT] [ITEM]"
    },
