        "A": {"values": [10,8,12,6,10,8]},
        "B": {"values": [15,10,20,10,15,10]}
      },
      "calculation": "2*(W+A-B)",
	  "options": [60,70,80,90],
      "explanation": "[P1]=W+A. [P2]=[P1]-B=W+A-B. [P4]=2*[P2]=2*([W]+[A]-[B])"
