{
  "puzzle_type": "upsc-analytical-complex-level-2",
  "display_name": "Analytical Complex Arrangement L2",
  "templates": [

    {
      "template_id": "AC_L2_01",
      "pattern": "Six persons [P1]-[P6] are of different ages. [P1] is [A] years old. [P2] is [K] years older than [P1]. [P3] is [M] years younger than [P2]. [P4] is twice the age of [P3]. How old is [P4]?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "A": {"values": [20,22,18,24,20,22]},
        "K": {"values": [5,6,4,6,5,6]},
        "M": {"values": [10,12,8,14,10,12]}
      },
      "calculation": "2*(A+K-M)",
	  "options": [28,30,32,34,36],
      "explanation": "[P2]=A+K. [P3]=[P2]-M=A+K-M. [P4]=2*[P3]=2*([A]+[K]-[M])"
    },
    {
      "template_id": "AC_L2_02",
      "pattern": "Five persons [P1]-[P5] live in a building with floors 1-5. [P2] lives on floor [F2]. [P4] lives [K] floors above [P2]. [P1] lives between [P2] and [P4]. [P5] lives on the topmost floor. [P3] lives on the ground floor. What floor does [P1] live on?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "F2": {"values": [2,2,2,2,2,2]},
        "K": {"values": [2,2,2,2,2,2]}
      },
      "calculation": "F2+1",
	  "options": [2,3,4,5],
      "explanation": "[P2]=F2, [P4]=F2+K. [P1] is between them: floor F2+1=[F2+1]"
    },
    {
