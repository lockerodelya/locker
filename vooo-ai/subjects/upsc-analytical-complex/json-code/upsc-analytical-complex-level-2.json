        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "DUMMY": {"values": [1,1,1,1,1,1]}
      },
      "calculation": "Reading",
	  "options": ["Reading","Cooking","Painting","Dancing","Gardening"],
      "explanation": "[P3]=Painting, [P4]=Cooking, [P5]=Dancing. [P1] not Cooking/Gardening → [P1]=Reading. [P2]=Gardening"
    },
    {
      "template_id": "AC_L2_04",
