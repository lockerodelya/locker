      "template_id": "AC_L3_01",
      "pattern": "Five persons [P1]-[P5] each have a different job and salary. Jobs: Manager=Rs.[JM]K, Engineer=Rs.[JE]K, Doctor=Rs.[JD]K, Teacher=Rs.[JT]K, Clerk=Rs.[JC]K. [P1] is a Doctor. [P3] earns more than [P2] but [P3] is not Manager. [P5] is a Clerk. [P4] is a Manager. [P2] is an Engineer. What is [P3]'s salary?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "JM": {"values": [80,90,75,100,80,90]},
        "JE": {"values": [60,70,55,80,60,70]},
        "JD": {"values": [90,100,85,110,90,100]},
        "JT": {"values": [50,55,45,60,50,55]},
        "JC": {"values": [30,35,25,40,30,35]}
      },
      "calculation": "JT",
		"options": [25,30,35,40,45,50,55,60],
      "explanation": "[P1]=Doctor, [P2]=Engineer, [P4]=Manager, [P5]=Clerk → [P3]=Teacher. [P3] salary = JT"
    },
