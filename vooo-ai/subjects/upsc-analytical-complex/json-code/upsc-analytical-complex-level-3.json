      },
      "calculation": "5*N1+K*(0+1+2+3+4)",
		"options": [125,150,175,200,225],
      "explanation": "Sales: Mon=N1, Tue=N1+K, Wed=N1+2K, Thu=N1+3K, Fri=N1+4K. Total=5*N1+10K"
    },
    {
      "template_id": "AC_L3_03",
      "pattern": "Seven persons [P1]-[P7] are seated at positions 1-7 from left. Each has a unique score. [P3] is at position [POS] and scored [SC]. [P1] is 2 places left of [P3] and scored [K] more than [P3]. [P5] is 2 places right of [P3] and scored [M] less than [P3]. What is the sum of [P1] and [P5]'s scores?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "POS": {"values": [4,4,4,4,4,4]},
        "SC": {"values": [60,70,50,80,60,70]},
        "K": {"values": [15,10,20,5,15,10]},
        "M": {"values": [20,15,10,25,20,15]}
      },
      "calculation": "(SC+K)+(SC-M)",
		"options": [105,110,115,120,125],
      "explanation": "[P1]=SC+K. [P5]=SC-M. Sum=[P1]+[P5]=(SC+K)+(SC-M)=2*SC+K-M"
    },
