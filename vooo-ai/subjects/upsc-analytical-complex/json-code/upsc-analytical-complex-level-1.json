    {
      "template_id": "AC_L1_01",
      "pattern": "Five persons [P1],[P2],[P3],[P4],[P5] live on 5 floors (1-5, ground=1). [P3] lives on floor [F3]. [P1] lives 2 floors above [P3]. [P5] lives on the topmost floor. [P4] lives just below [P2]. Who lives on floor 2?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "F3": {"values": [2,2,2,2,2,2]}
      },
      "calculation": "P4",
		"options": ["Amit","Ram","Bina","Sita","Charu","Tara","Dev","Uday","Elan","Vinay"],
      "explanation": "Floor order: 1=[P3], 2=[P4], 3=[P2], 4=[P1]... wait [P1]=F3+2=4. [P5]=5. [P4] just below [P2]: floors 2 and 3. Floor 2 = [P4]"
    },
