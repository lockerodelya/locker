{
  "puzzle_type": "upsc-analytical-complex-level-4",
  "display_name": "Analytical Complex Arrangement L4",
  "templates": [

    {
      "template_id": "AC_L4_01",
      "pattern": "Eight persons [P1]-[P8] are of heights (cm): [H1],[H2],[H3],[H4],[H5],[H6],[H7],[H8]. [P1]=[H1]cm. [P2] is [A]cm taller than [P1]. [P3] is [B]cm shorter than [P2]. [P4]'s height is the average of [P2] and [P3]. How tall is [P4]?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "H1": {"values": [160,162,158,165,160,162]},
        "A": {"values": [10,8,12,5,10,8]},
        "B": {"values": [6,4,8,2,6,4]}
      },
      "calculation": "(H1+A+(H1+A-B))/2",
		"options": [164,165,166,167,168,169],
      "explanation": "[P2]=H1+A. [P3]=H1+A-B. [P4]=([P2]+[P3])/2=([H1]+[A]+[H1]+[A]-[B])/2"
    },
    {
      "template_id": "AC_L4_02",
      "pattern": "Five persons [P1]-[P5] work in 5 different companies and earn different salaries. [P2] earns more than [P1] but less than [P4]. [P3] earns the most. [P5] earns less than [P1]. The salaries are Rs.[S1]K,[S2]K,[S3]K,[S4]K,[S5]K (in some order). [P1] earns Rs.[S1]K. What does [P4] earn?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P4": {"values": ["Dev","Uday","Rohit","Sunil","Kiran","Nitin"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "S1": {"values": [40,45,35,50,40,45]},
        "S2": {"values": [50,55,45,60,50,55]},
        "S3": {"values": [70,75,65,80,70,75]},
        "S4": {"values": [60,65,55,70,60,65]},
        "S5": {"values": [30,35,25,40,30,35]}
      },
      "calculation": "S4",
		"options": [50,55,60,65,70,75],
      "explanation": "Order: [P3]>[P4]>[P2]>[P1]>[P5]. [P1]=S1. So [P4]=S4 (3rd highest = 2nd from top after [P3])"
    },
    {
      "template_id": "AC_L4_03",
      "pattern": "Seven persons [P1]-[P7] are born in 7 different years: [Y1],[Y2],[Y3],[Y4],[Y5],[Y6],[Y7]. [P1] born in [Y1]. [P3] born [K] years after [P1]. [P5] born [M] years before [P3]. [P7] is oldest (born [Y7]). [P2] born in [Y2]. Age difference between [P3] and [P5] is [D] years. What year was [P5] born?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "P5": {"values": ["Elan","Vinay","Sahil","Tarun","Lucky","Pawan"]},
        "Y1": {"values": [1990,1992,1988,1994,1990,1992]},
        "K": {"values": [5,4,6,3,5,4]},
        "M": {"values": [3,2,4,1,3,2]},
        "Y7": {"values": [1975,1977,1973,1979,1975,1977]},
        "Y2": {"values": [1985,1987,1983,1989,1985,1987]},
        "D": {"values": [3,2,4,1,3,2]}
      },
      "calculation": "Y1+K-M",
		"options": [1988,1990,1992,1994,1996],
      "explanation": "[P3]=Y1+K. [P5]=[P3]-M=Y1+K-M=[Y1]+[K]-[M]"
    },
    {
      "template_id": "AC_L4_04",
      "pattern": "Five teams [T1]-[T5] played a league. Each team played [N] matches. Points: Win=3, Draw=1, Loss=0. [T1] won [W1] matches, drew [D1], lost [L1]. [T2] won [W2], drew [D2], lost [L2]. Which team has more points, [T1] or [T2]?",
