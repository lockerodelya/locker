  "templates": [
    {
      "template_id": "BAR_L2_01",
      "pattern": "A pie chart shows age groups: Below 18=[Y]%, 18-60=[A]%, Above 60=[O]%. In a town of [POP] people, how many are aged 18-60?",
      "variables": {
        "Y": { "values": [25, 30, 20, 35, 28, 22] },
        "A": { "values": [60, 55, 65, 50, 58, 63] },
        "O": { "values": [15, 15, 15, 15, 14, 15] },
        "POP": { "values": [10000, 20000, 15000, 25000, 8000, 12000] }
      },
      "calculation": "(A/100)*POP",
      "explanation": "Age 18-60 = (A% ÷ 100) × Population = ([A]/100) × [POP]",
      "options": [6000, 11000, 9750, 12500, 4640, 7560]
    },
    {
      "template_id": "BAR_L2_02",
      "pattern": "A bar graph shows student performance: Pass=[P], Fail=[F], Absent=[AB]. What % passed?",
      "variables": {
        "P": { "values": [80, 150, 200, 250, 120, 180] },
        "F": { "values": [15, 30, 40, 40, 25, 35] },
        "AB": { "values": [5, 20, 10, 10, 5, 15] }
      },
      "calculation": "(P/(P+F+AB))*100",
      "explanation": "Pass % = (P ÷ Total) × 100 = ([P] ÷ ([P]+[F]+[AB])) × 100",
      "options": [80, 75, 80, 83.3, 80, 78.3]
    },
    {
      "template_id": "BAR_L2_03",
      "pattern": "A bar graph shows GDP growth: Year 1=[G1]%, Year 2=[G2]%, Year 3=[G3]%. Average growth rate?",
