    {
      "template_id": "BAR_L1_01",
      "pattern": "A bar graph shows sales: Product A=[A] units, Product B=[B] units, Product C=[C] units. Total sales?",
      "variables": {
        "A": { "values": [200, 300, 400, 500, 250, 350] },
        "B": { "values": [300, 400, 500, 600, 350, 450] },
        "C": { "values": [400, 500, 300, 700, 450, 400] }
      },
      "calculation": "A+B+C",
      "explanation": "Total = A+B+C = [A]+[B]+[C]",
      "options": [900, 1200, 1200, 1800, 1050, 1200]
    },
    {
      "template_id": "BAR_L1_02",
