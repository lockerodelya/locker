      "variables": {
        "J": { "values": [80, 60, 100, 120, 50, 90] },
        "F": { "values": [60, 80, 80, 100, 70, 70] },
        "M": { "values": [100, 100, 60, 80, 90, 110] },
        "A": { "values": [40, 120, 120, 60, 80, 60] }
      },
      "calculation": "Math.max(J,F,M,A)",
      "explanation": "Highest rainfall = maximum of all months",
      "options": ["Mar", "Apr", "Mar/Apr", "Jan", "Mar", "Mar"]
    },
    {
