{
  "puzzle_type": "upsc-bar-graph-level-3",
  "display_name": "Bargraph L3",
  "templates": [
    {
      "template_id": "BAR_L3_01",
      "pattern": "A bar graph shows hospital admissions over 4 weeks: Week1=[W1], Week2=[W2], Week3=[W3], Week4=[W4]. By how much did Week4 exceed Week1?",
      "variables": {
        "W1": { "values": [120, 200, 150, 180, 100, 250] },
        "W2": { "values": [140, 220, 170, 200, 130, 270] },
        "W3": { "values": [160, 250, 190, 230, 150, 300] },
        "W4": { "values": [200, 300, 240, 280, 190, 370] }
      },
      "calculation": "W4-W1",
      "explanation": "Excess = Week4 - Week1 = [W4]-[W1]",
      "options": [80, 100, 90, 100, 90, 120]
    },
    {
      "template_id": "BAR_L3_02",
      "pattern": "A pie chart shows distribution of employees by department: HR=[H]%, IT=[I]%, Finance=[F]%, Operations=[O]%. Total employees = [TOT]. How many are in IT?",
      "variables": {
        "H": { "values": [15, 20, 10, 18, 12, 16] },
        "I": { "values": [35, 30, 40, 32, 38, 34] },
        "F": { "values": [25, 28, 30, 25, 28, 26] },
        "O": { "values": [25, 22, 20, 25, 22, 24] },
        "TOT": { "values": [400, 500, 600, 800, 1000, 1200] }
      },
      "calculation": "(I/100)*TOT",
      "explanation": "IT employees = (I% ÷ 100) × Total = ([I]/100) × [TOT]",
      "options": [140, 150, 240, 256, 380, 408]
    },
    {
      "template_id": "BAR_L3_03",
      "pattern": "A bar graph shows the number of vehicles on road: Cars=[C], Buses=[B], Trucks=[T], Bikes=[BK]. What is the ratio of Cars to Trucks?",
      "variables": {
        "C": { "values": [600, 900, 400, 750, 500, 1200] },
        "B": { "values": [100, 150, 80, 125, 100, 200] },
        "T": { "values": [200, 300, 200, 250, 250, 400] },
        "BK": { "values": [400, 600, 320, 500, 350, 800] }
      },
      "calculation": "C/T",
      "explanation": "Ratio = Cars : Trucks = [C]:[T] simplified",
      "options": ["3:1", "3:1", "2:1", "3:1", "2:1", "3:1"]
    },
    {
      "template_id": "BAR_L3_04",
