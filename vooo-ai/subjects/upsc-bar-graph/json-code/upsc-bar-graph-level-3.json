        "M1": { "values": [40, 60, 80, 50, 70, 90] },
        "M2": { "values": [50, 70, 60, 80, 50, 70] },
        "M3": { "values": [60, 50, 100, 70, 90, 80] },
        "M4": { "values": [80, 80, 40, 60, 60, 100] },
        "M5": { "values": [70, 90, 70, 90, 80, 110] }
      },
      "calculation": "(M1+M2+M3+M4+M5)/5",
      "explanation": "Average = (M1+M2+M3+M4+M5) ÷ 5 = ([M1]+[M2]+[M3]+[M4]+[M5]) ÷ 5",
