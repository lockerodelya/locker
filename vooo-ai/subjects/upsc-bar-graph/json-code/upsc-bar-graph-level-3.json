        "AG": { "values": [45, 40, 42, 38, 44, 42] },
        "O": { "values": [5, 7, 8, 10, 8, 8] },
        "TOT": { "values": [200, 500, 300, 400, 250, 600] }
      },
      "calculation": "(AG/100)*TOT",
      "explanation": "Agricultural usage = (AG% ÷ 100) × Total = ([AG]/100) × [TOT]",
      "options": [90, 200, 126, 152, 110, 252]
