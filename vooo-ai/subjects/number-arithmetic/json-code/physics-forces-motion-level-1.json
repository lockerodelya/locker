{
  "puzzle_type": "physics-forces-motion-level-1",
  "display_name": "Forces & Motion L1",
  "templates": [

    {
      "template_id": "FM_L1_01",
      "pattern": "An object travels [DIST] km in [TIME] hours. What is its average speed?",
      "variables": {
        "DIST": {"min": 20, "max": 500, "step": 5},
        "TIME": {"min": 1, "max": 20, "step": 1}
      },
      "constraints": ["DIST % TIME === 0"],
      "calculation": "DIST / TIME",
      "explanation": "Speed = Distance ÷ Time = [DIST] ÷ [TIME] = [RESULT] km/h"
    },

    {
      "template_id": "FM_L1_02",
      "pattern": "A car moves at [SPEED] km/h for [TIME] hours. How far does it travel?",
      "variables": {
        "SPEED": {"min": 10, "max": 120, "step": 5},
        "TIME":  {"min": 1,  "max": 10,  "step": 1}
      },
      "calculation": "SPEED * TIME",
      "explanation": "Distance = Speed × Time = [SPEED] × [TIME] = [RESULT] km"
    },

    {
      "template_id": "FM_L1_03",
      "pattern": "A train travels [DIST] km at a constant speed of [SPEED] km/h. How long does the journey take?",
      "variables": {
        "SPEED": {"min": 10, "max": 100, "step": 10},
        "DIST":  {"min": 10, "max": 500, "step": 10}
      },
      "constraints": ["DIST % SPEED === 0"],
      "calculation": "DIST / SPEED",
      "explanation": "Time = Distance ÷ Speed = [DIST] ÷ [SPEED] = [RESULT] hours"
    },

    {
      "template_id": "FM_L1_04",
      "pattern": "A vehicle accelerates from [U] m/s to [V] m/s in [T] seconds. What is its acceleration?",
      "variables": {
        "U": {"min": 0,  "max": 20, "step": 2},
        "V": {"min": 10, "max": 50, "step": 2},
        "T": {"min": 2,  "max": 20, "step": 2}
      },
      "constraints": ["V > U", "(V - U) % T === 0"],
      "calculation": "(V - U) / T",
      "explanation": "Acceleration = (Final velocity − Initial velocity) ÷ Time = ([V] − [U]) ÷ [T] = [RESULT] m/s²"
    },

    {
      "template_id": "FM_L1_05",
      "pattern": "A force of [F] N acts on an object of mass [M] kg. What is the acceleration produced?",
      "variables": {
        "F": {"min": 10, "max": 200, "step": 10},
        "M": {"min": 2,  "max": 40,  "step": 2}
      },
      "constraints": ["F % M === 0"],
      "calculation": "F / M",
      "explanation": "Using Newton's Second Law: Acceleration = Force ÷ Mass = [F] ÷ [M] = [RESULT] m/s²"
    },

    {
      "template_id": "FM_L1_06",
      "pattern": "An object of mass [M] kg is moving at [V] m/s. What is its kinetic energy?",
      "variables": {
        "M": {"min": 1,  "max": 50, "step": 1},
        "V": {"min": 2,  "max": 30, "step": 2}
      },
      "calculation": "0.5 * M * V * V",
      "explanation": "Kinetic Energy = ½ × mass × velocity² = 0.5 × [M] × [V]² = 0.5 × [M] × [V*V] = [RESULT] J"
    },

    {
      "template_id": "FM_L1_07",
      "pattern": "Calculate the momentum of an object with mass [M] kg moving at [V] m/s.",
      "variables": {
        "M": {"min": 1,  "max": 60, "step": 1},
        "V": {"min": 2,  "max": 40, "step": 2}
      },
      "calculation": "M * V",
      "explanation": "Momentum = Mass × Velocity = [M] × [V] = [RESULT] kg·m/s"
    },

    {
      "template_id": "FM_L1_08",
      "pattern": "A force of [F] N moves an object [D] m in the direction of the force. How much work is done?",
      "variables": {
        "F": {"min": 5,  "max": 100, "step": 5},
        "D": {"min": 2,  "max": 50,  "step": 2}
      },
      "calculation": "F * D",
      "explanation": "Work Done = Force × Distance = [F] × [D] = [RESULT] J"
    },

    {
      "template_id": "FM_L1_09",
      "pattern": "[W] J of work is done in [T] seconds. What is the power output?",
      "variables": {
        "W": {"min": 100, "max": 2000, "step": 100},
        "T": {"min": 2,   "max": 20,   "step": 2}
      },
      "constraints": ["W % T === 0"],
      "calculation": "W / T",
      "explanation": "Power = Work Done ÷ Time = [W] ÷ [T] = [RESULT] W (watts)"
    },

    {
      "template_id": "FM_L1_10",
      "pattern": "An object of mass [M] kg is at a height of [H] m. What is its gravitational potential energy? (g = 10 m/s²)",
      "variables": {
        "M": {"min": 1,  "max": 50, "step": 1},
        "H": {"min": 2,  "max": 40, "step": 2}
      },
      "calculation": "M * 10 * H",
      "explanation": "GPE = mass × g × height = [M] × 10 × [H] = [RESULT] J"
    }

  ],
