{
  "puzzle_type": "upsc-ranking-time-level-3",
  "display_name": "Ranking & Time Seq. L3",
  "templates": [

    {
      "template_id": "RTS_L3_01",
      "pattern": "[P1] ranks [A]th from top and [B]th from bottom. [P2] ranks [C] places below [P1]. What is [P2]'s rank from the bottom?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "A": {"values": [8,10,6,12,8,10]},
        "B": {"values": [12,14,10,16,12,14]},
        "C": {"values": [4,5,3,6,4,5]}
      },
      "calculation": "0",
      "explanation": "Total N = A+B-1. [P2] rank from top = A+C. From bottom = N-(A+C)+1 = B-C = [B]-[C]",
      "options": [8,9,7,10,8,9]
    },
    {
      "template_id": "RTS_L3_02",
      "pattern": "[P1] is [A]th from top in a class. After [K] students above [P1] leave, [P1] becomes [B]th from top. How many students were originally above [P1] who did not leave?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "A": {"values": [15,18,12,20,15,18]},
        "K": {"values": [8,10,6,12,8,10]},
        "B": {"values": [7,8,6,8,7,8]}
      },
      "calculation": "A-K-1",
      "explanation": "Remaining above = Original above - Left = (A-1) - K = [A]-1-[K]",
      "options": [6,7,5,7,6,7]
    },
    {
      "template_id": "RTS_L3_03",
      "pattern": "In a queue, [P1] is [A]th from front and [B]th from back. [P2] joins behind [P1] but in front of [C] others. What is [P2]'s position from the front?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "A": {"values": [8,10,6,12,8,10]},
        "B": {"values": [7,9,5,11,7,9]},
        "C": {"values": [3,4,2,5,3,4]}
      },
      "calculation": "A+B-C",
      "explanation": "Total N = A+B-1. [P2] joins behind [P1], in front of C others → [P2] from front = N+1-C = A+B-C = [A]+[B]-[C]",
      "options": [12,15,9,18,12,15]
    },
    {
      "template_id": "RTS_L3_04",
      "pattern": "[P1] was born in year [BY]. [P2] is [K] years older than [P1]. [P3] is [M] years younger than [P2]. In year [CY], what is the age difference between [P1] and [P3]?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "BY": {"values": [1990,1985,1995,1980,1990,1985]},
        "K": {"values": [5,8,3,10,5,8]},
        "M": {"values": [3,5,1,7,3,5]},
        "CY": {"values": [2026,2026,2026,2026,2026,2026]}
      },
      "calculation": "Math.abs(K-M)",
      "explanation": "[P3] is K-M years older/younger than [P1]. Age difference = |K-M| = |[K]-[M]|",
      "options": [2,3,2,3,2,3]
    },
    {
      "template_id": "RTS_L3_05",
      "pattern": "[P1] scores [S1] in round 1, [S2] in round 2, and [S3] in round 3. [P2] scores [T1],[T2],[T3] in the three rounds. The player with the higher total wins. Who wins and by how many points?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "S1": {"values": [25,30,20,35,25,30]},
        "S2": {"values": [30,25,35,30,30,25]},
        "S3": {"values": [20,35,25,25,20,35]},
        "T1": {"values": [28,27,22,32,28,27]},
        "T2": {"values": [27,28,33,28,27,28]},
        "T3": {"values": [22,22,22,22,22,22]}
      },
      "calculation": "Math.abs((S1+S2+S3)-(T1+T2+T3))",
      "explanation": "[P1] total = S1+S2+S3. [P2] total = T1+T2+T3. Difference = |[P1]total - [P2]total|",
      "options": [2,13,3,8,2,13]
    },
    {
      "template_id": "RTS_L3_06",
      "pattern": "In a tournament with [N] players, [P1] beats everyone ranked below [A] (from top). How many players did [P1] beat?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "N": {"values": [16,32,16,32,16,32]},
        "A": {"values": [3,5,4,6,3,5]}
      },
      "calculation": "N-A",
      "explanation": "Players [P1] beat = Total - rank of [P1] = [N]-[A]",
      "options": [13,27,12,26,13,27]
    },
    {
      "template_id": "RTS_L3_07",
      "pattern": "In a class, [P1] is [A]th from top. [P2] is [B]th from top. [P3] is exactly midway between [P1] and [P2]. What is [P3]'s rank from top?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "A": {"values": [5,4,6,3,5,4]},
        "B": {"values": [15,16,14,17,15,16]}
      },
      "calculation": "(A+B)/2",
      "explanation": "[P3] rank = (A+B)/2 = ([A]+[B])/2",
      "options": [10,10,10,10,10,10]
    },
    {
      "template_id": "RTS_L3_08",
      "pattern": "In an exam, [P1] answered [Q1] questions in [T1] minutes. At the same rate, how many questions can [P1] answer in [T2] minutes?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "Q1": {"values": [15,20,12,25,18,16]},
        "T1": {"values": [30,40,24,50,36,32]},
        "T2": {"values": [60,60,60,60,60,60]}
      },
      "calculation": "(Q1/T1)*T2",
      "explanation": "Rate = Q1/T1 questions per minute. In T2 mins = (Q1/T1)*T2 = ([Q1]/[T1])*[T2]",
      "options": [30,30,30,30,30,30]
    },
    {
      "template_id": "RTS_L3_09",
      "pattern": "In a row of [N] persons, [P1] and [P2] interchange positions. [P1] was [A]th from left, now becomes [B]th from left. What was [P2]'s original position from the right?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "N": {"values": [20,25,18,22,20,25]},
        "A": {"values": [5,6,4,7,5,6]},
        "B": {"values": [12,15,9,14,12,15]}
      },
      "calculation": "N-A+1",
      "explanation": "[P2]'s original position = [P1]'s new position = B from left. From right = N-B+1. But [P2] was at A's place originally, so [P2] was at B from left. [P2] original from right = N-B+1",
      "options": [9,11,10,9,9,11]
    },
    {
      "template_id": "RTS_L3_10",
      "pattern": "[P1] is [A] years older than [P2]. [P3] is [B] years younger than [P1]. Sum of ages of [P2] and [P3] is [SUM]. What is [P1]'s age?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "A": {"values": [5,8,4,10,5,8]},
        "B": {"values": [3,5,2,6,3,5]},
        "SUM": {"values": [49,56,46,60,49,56]}
      },
      "calculation": "(SUM+A+B)/2",
      "explanation": "[P2]=[P1]-A, [P3]=[P1]-B. [P2]+[P3]=SUM → 2*[P1]-A-B=SUM → [P1]=(SUM+A+B)/2=([SUM]+[A]+[B])/2",
      "options": [28.5,34.5,26,38,28.5,34.5]
    },
    {
      "template_id": "RTS_L3_11",
      "pattern": "In a class ranking test, [P1] is [A]th, [P2] is [B]th, and [P3] is exactly between them at rank [C]th. What is the total number of students between [P1] and [P2]?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "A": {"values": [4,5,3,6,4,5]},
        "B": {"values": [20,21,19,22,20,21]},
        "C": {"values": [12,13,11,14,12,13]}
      },
      "calculation": "B-A-1",
      "explanation": "Students between [P1] and [P2] = B-A-1 = [B]-[A]-1",
      "options": [15,15,15,15,15,15]
    },
    {
      "template_id": "RTS_L3_12",
      "pattern": "In a class, [P1] is ranked [A]th from top. There are [K] students between [P1] and [P2]. [P2] is below [P1]. [P3] is [M] ranks above [P2]. What is [P3]'s rank from the top?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "A": {"values": [5,6,4,7,5,6]},
        "K": {"values": [4,5,3,6,4,5]},
        "M": {"values": [3,4,2,5,3,4]}
      },
      "calculation": "A+K+1-M",
      "explanation": "[P2] rank = A+K+1. [P3] = [P2]-M = A+K+1-M = [A]+[K]+1-[M]",
      "options": [7,8,6,9,7,8]
    },
    {
      "template_id": "RTS_L3_13",
      "pattern": "In a competition, [P1] ranks [A]th. [P2] says '[P1] ranked [X] places below me.' [P3] says '[P2] ranked [Y] places above me.' What is [P3]'s rank?",
      "variables": {
        "P1": {"values": ["Amit","Ram","Suresh","Anil","Vijay","Mohan"]},
        "P2": {"values": ["Bina","Sita","Priya","Mona","Neha","Pooja"]},
        "P3": {"values": ["Charu","Tara","Kavya","Rita","Sneha","Lata"]},
        "A": {"values": [10,12,8,14,10,12]},
        "X": {"values": [3,4,2,5,3,4]},
        "Y": {"values": [5,6,4,7,5,6]}
      },
      "calculation": "A-X+Y",
      "explanation": "[P2] rank = A-X. [P3] rank = [P2]+Y = A-X+Y = [A]-[X]+[Y]",
      "options": [12,14,10,16,12,14]
    }

