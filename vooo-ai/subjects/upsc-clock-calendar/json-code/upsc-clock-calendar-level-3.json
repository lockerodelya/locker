      "explanation": "LCM(1, N) = N days."
    },
    {
      "template_id": "CC_L3_09",
      "pattern": "An ordinary year starts on day [D] (Mon=1). On which day number does it end?",
      "variables": {
        "D": {"values": [1, 2, 3, 4, 5, 6]},
        "DUMMY": {"values": [1,1,1,1,1,1]}
      },
      "calculation": "(D%7)+1",
      "options": [1, 2, 3, 4, 5, 6, 7],
      "explanation": "Ordinary year = 365 = 52*7 + 1. End day = (D mod 7) + 1."
    },
    {
      "template_id": "CC_L3_10",
      "pattern": "A leap year has [D] days. How many odd days does it have?",
      "variables": {
        "D": {"values": [366, 366, 366, 366, 366, 366]},
        "DUMMY": {"values": [1,1,1,1,1,1]}
      },
      "calculation": "366%7",
      "options": [1, 2, 3, 4, 5, 6],
      "explanation": "366 mod 7 = 2. A leap year has 2 odd days."
    },
    {
      "template_id": "CC_L3_11",
      "pattern": "Ram says 'Day before yesterday was [D] (Mon=1).' What day number is it today?",
      "variables": {
        "D": {"values": [1, 2, 3, 4, 5, 6]},
        "DUMMY": {"values": [1,1,1,1,1,1]}
      },
      "calculation": "((D+1)%7)+1",
      "options": [1, 2, 3, 4, 5, 6, 7],
      "explanation": "Today = day before yesterday + 2 = D+2. Answer = ((D+1) mod 7)+1."
    },
