      "calculation": "Math.abs(30*H-5.5*M)",
      "options": [0, 30, 60, 75, 90, 105, 110, 120, 150, 180],
      "explanation": "Angle = |30H - 5.5M| = |30*[H] - 5.5*[M]| degrees."
    },
    {
      "template_id": "CC_L3_07",
