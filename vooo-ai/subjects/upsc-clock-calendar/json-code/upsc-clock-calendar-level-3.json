      "variables": {
        "G": {"values": [2, 3, 4, 5, 6, 1]},
        "D": {"values": [1, 2, 3, 1, 2, 5]}
      },
      "calculation": "G*24*D",
      "options": [24, 48, 72, 96, 120, 144, 240, 288],
      "explanation": "Gain = G * 24 * D = [G]*24*[D] seconds."
    },
    {
      "template_id": "CC_L3_08",
      "pattern": "A train runs every [N] days. Another runs daily. After how many days will they next depart together?",
      "variables": {
        "N": {"values": [3, 4, 5, 6, 7, 8]},
