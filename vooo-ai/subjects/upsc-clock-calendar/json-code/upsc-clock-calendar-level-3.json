    {
      "template_id": "CC_L3_01",
      "pattern": "A clock gains [G] seconds every minute. How many minutes does it gain in [H] hours?",
      "variables": {
        "G": {"values": [2, 3, 4, 5, 6, 1]},
        "H": {"values": [6, 4, 3, 2, 5, 12]}
      },
      "calculation": "G*H*60/60",
      "options": [6, 8, 10, 12, 18, 20, 24, 30, 36, 72],
      "explanation": "Gain per minute = [G] seconds. In [H] hours = [H]*60 minutes. Total gain = [G]*[H] minutes."
    },
    {
      "template_id": "CC_L3_02",
      "pattern": "A clock gains [G] minutes per day. How many minutes ahead will it be after [N] days?",
      "variables": {
        "G": {"values": [5, 10, 3, 6, 4, 8]},
        "N": {"values": [3, 2, 4, 3, 5, 2]}
      },
      "calculation": "G*N",
      "options": [6, 8, 10, 12, 15, 16, 20, 30],
      "explanation": "Total gain = G*N = [G]*[N] minutes."
    },
    {
      "template_id": "CC_L3_03",
      "pattern": "A person was born in [Y]. How old will they be in [Y2]?",
      "variables": {
        "Y": {"values": [1990, 1985, 1995, 1980, 2000, 1975]},
        "Y2": {"values": [2025, 2025, 2025, 2025, 2025, 2025]}
