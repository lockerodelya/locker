      "calculation": "Y2-Y",
      "options": [25, 30, 35, 40, 45, 50],
      "explanation": "Age = Y2 - Y = [Y2] - [Y] years."
    },
    {
      "template_id": "CC_L3_04",
      "pattern": "A clock strikes once at 1, twice at 2... How many times does it strike in [N] hours starting from 1 o'clock?",
      "variables": {
        "N": {"values": [12, 6, 3, 9, 4, 8]},
        "DUMMY": {"values": [1,1,1,1,1,1]}
      },
      "calculation": "N*(N+1)/2",
      "options": [6, 10, 21, 36, 45, 55, 66, 78],
      "explanation": "Total strikes = 1+2+...+N = N*(N+1)/2 = [N]*([N]+1)/2."
    },
    {
      "template_id": "CC_L3_05",
      "pattern": "Today is [DAY_N] (as number: Mon=1...Sun=7). What day number is it [K] days later?",
      "variables": {
        "DAY_N": {"values": [1, 2, 3, 4, 5, 6]},
        "K": {"values": [6, 5, 4, 10, 9, 8]}
      },
      "calculation": "((DAY_N+K-1)%7)+1",
      "options": [1, 2, 3, 4, 5, 6, 7],
      "explanation": "Day = ((DAY_N + K - 1) mod 7) + 1."
    },
    {
      "template_id": "CC_L3_06",
      "pattern": "At [H]:[M], what is the angle between the clock hands (in degrees)?",
      "variables": {
        "H": {"values": [3, 6, 9, 2, 4, 8]},
        "M": {"values": [0, 30, 0, 30, 20, 40]}
