      "pattern": "No [INSTRUMENT] can make music without [REQUIREMENT]. [ITEM] is a [INSTRUMENT]. Can [ITEM] make music without [REQUIREMENT]?",
      "variables": {
        "INSTRUMENT": {"values": ["piano", "guitar", "drum", "flute", "violin", "trumpet"]},
        "REQUIREMENT": {"values": ["a player", "someone to play it", "a musician", "being played", "human interaction", "a skilled player"]},
        "ITEM": {"values": ["this", "that", "it", "the one in the corner", "what is on the stage", "the instrument described"]}
      },
      "calculation": "'No'",
      "explanation": "No [INSTRUMENT] can make music without [REQUIREMENT], so [ITEM] being a [INSTRUMENT] means it cannot make music without [REQUIREMENT]",
      "options": ["No", "Yes", "Maybe", "Sometimes"]
