  "templates": [

    {
      "template_id": "BAS_REG_L11_01",
      "pattern": "No [BOOK_TYPE] can be read without [SKILL]. [ITEM] is a [BOOK_TYPE]. Can [ITEM] be read without [SKILL]?",
      "variables": {
        "BOOK_TYPE": {"values": ["novels", "textbooks", "newspapers", "comic books", "encyclopedias", "manuals"]},
        "SKILL": {"values": ["literacy", "reading ability", "the ability to read", "reading skills", "basic reading", "knowledge of the language"]},
        "ITEM": {"values": ["this", "that", "it", "the one in my hand", "what I am holding", "the book on the table"]}
      },
      "calculation": "'No'",
      "explanation": "No [BOOK_TYPE] can be read without [SKILL], so [ITEM] being a [BOOK_TYPE] means it cannot be read without [SKILL]",
      "options": ["No", "Yes", "Maybe", "Sometimes"]
    },
    {
      "template_id": "BAS_REG_L11_02",
      "pattern": "No [BOOK_PART] exists without [MAIN_PART]. [SECTION] is a [BOOK_PART]. Can [SECTION] exist without [MAIN_PART]?",
