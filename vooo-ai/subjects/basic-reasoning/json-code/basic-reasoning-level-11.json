        "BOOK_PART": {"values": ["index", "table of contents", "glossary", "appendix", "footnotes", "bibliography"]},
        "MAIN_PART": {"values": ["the book", "main content", "the text", "the main body", "written content", "core material"]},
        "SECTION": {"values": ["this", "that", "it", "the one at the back", "what I am looking at", "the section described"]}
      },
      "calculation": "'No'",
      "explanation": "No [BOOK_PART] exists without [MAIN_PART], so [SECTION] being a [BOOK_PART] means it cannot exist without [MAIN_PART]",
      "options": ["No", "Yes", "Maybe", "Sometimes"]
    },
