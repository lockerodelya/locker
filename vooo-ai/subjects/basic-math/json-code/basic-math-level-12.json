    {
      "template_id": "BAS_MATH_L12_09",
      "pattern": "[A] shared equally among [B] = ?",
      "variables": {
        "A": {
          "min": 20,
          "max": 100,
          "step": 5
        },
        "B": {
          "min": 2,
          "max": 10
        }
      },
      "calculation": "A / B",
      "constraints": ["A % B === 0"],
      "explanation": "[A] shared equally among [B] = [A] ÷ [B] = [RESULT] each"
    },
    {
      "template_id": "BAS_MATH_L12_10",
      "pattern": "Which is smaller: [A] or [B]?",
