      "pattern": "I have [A] apples. I get [B] more. How many total?",
      "variables": {
        "A": {"min": 1, "max": 100},
        "B": {"min": 1, "max": 100}
      },
      "calculation": "A + B",
      "explanation": "[A] + [B] = [RESULT]"
