      "pattern": "Which is bigger: [A] or [B]?",
      "variables": {
        "A": {"min": 1, "max": 100},
        "B": {"min": 1, "max": 100}
      },
      "calculation": "(A > B) ? A : B",
      "explanation": "[RESULT] is the bigger number."
    },
