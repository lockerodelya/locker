      "B": {"min": 1, "max": 10},
      "ITEM": {"values": ["cookies", "candies", "balloons", "stickers", "pencils", "crayons", "marbles", "blocks"]}
    },
    "constraints": ["A > B"],
    "calculation": "A - B",
    "explanation": "[A] - [B] = [RESULT] [ITEM] left"
  },
