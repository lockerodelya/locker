{
    "template_id": "BAS_MATH_L18_06",
    "pattern": "What comes next? [A], [A+STEP], [A+2*STEP], ?",
    "variables": {
      "A": {"min": 2, "max": 30},
      "STEP": {"values": [2, 3, 4, 5, 6, 7, 8, 9, 10]}
    },
    "constraints": ["A + (3*STEP) <= 100"],
    "calculation": "A + (3 * STEP)",
    "explanation": "Add [STEP] each time: [A], [A+STEP], [A+2*STEP], next is [RESULT]"
  },
  {
    "template_id": "BAS_MATH_L18_07",
    "pattern": "Complete the pattern: [FIRST], [SECOND], ?, ...",
    "variables": {
      "FIRST": {"min": 1, "max": 25},
      "SECOND": {"min": 2, "max": 30}
    },
    "constraints": ["SECOND > FIRST", "SECOND - FIRST <= 15", "SECOND + (SECOND-FIRST) <= 100"],
    "calculation": "SECOND + (SECOND - FIRST)",
    "explanation": "The difference is [SECOND-FIRST], so next is [RESULT]"
  },
{
