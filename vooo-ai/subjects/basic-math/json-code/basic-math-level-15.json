      "pattern": "Which is greater: [A] × [B] or [C] + [D]?",
      "variables": {
        "A": {"min": 3, "max": 8},
        "B": {"min": 3, "max": 8},
        "C": {"min": 10, "max": 40},
        "D": {"min": 10, "max": 40}
      },
      "calculation": "(A * B) > (C + D) ? (A * B) : (C + D)",
      "constraints": ["A * B !== C + D"],
      "explanation": "[A] × [B] = [A*B] and [C] + [D] = [C+D]. Greater value is [RESULT]"
    },
