FileETag MTime Size
RewriteEngine On
ErrorDocument 404 /404.html

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.odelya\.online [NC]
RewriteRule ^ https://odelya.online%{REQUEST_URI} [R=301,L,NE]

# Force HTTPS (handles both direct and reverse proxy)
RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://odelya.online%{REQUEST_URI} [R=301,L,NE]

# Remove trailing slash (non-dirs only)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$ [NC]
RewriteRule ^(.*)/$ /$1 [R=301,L,NE]

# .html → clean URL redirect
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Clean URL → .html (internal)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# ====== CACHING ======
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 0 seconds"
    ExpiresByType image/jpg                "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/gif                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # HTML — never cache
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    # JS and CSS — 1 year
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Images and fonts — 1 year immutable
    <FilesMatch "\.(webp|png|jpg|jpeg|ico|gif|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
